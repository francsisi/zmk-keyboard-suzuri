#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

#define DEFAULT 0
#define LAYER1  1
#define LAYER2  2

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &mkp LCLK    &mkp RCLK
                &mo LAYER1   &mo LAYER2
            >;
        };

        layer_1 {
            bindings = <
                &mkp MB4     &mkp MB5
                &trans       &mkp MCLK
            >;
        };

        layer_2 {
            bindings = <
                &kp LC(C)    &kp LC(V)
                &kp LC(X)    &trans
            >;
        };
    };
};